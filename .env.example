APP_NAME="ISP Management Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://isp-mbp.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL Database (Shared by Laravel & FreeRADIUS rlm_sql)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=isp_mbp
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=isp_mbp_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@isp-mbp.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# FreeRADIUS & NAS Configuration
RADIUS_USE_FREERADIUS_AAA=true
RADIUS_SERVER_IP=192.168.88.10
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_COA_PORT=3799
RADIUS_DEFAULT_NAS_IP=192.168.88.1
RADIUS_TUNNEL_NAS_IP=192.168.88.254
RADIUS_DEFAULT_NAS_SHORTNAME=ISP-MBP-CCR2116-CORE
RADIUS_DEFAULT_NAS_SECRET=testing123

# Default MikroTik RouterOS Edge Device
MIKROTIK_DEFAULT_HOST=192.168.88.1
MIKROTIK_DEFAULT_USERNAME=admin
MIKROTIK_DEFAULT_PASSWORD=password
MIKROTIK_DEFAULT_WEB_PORT=80
MIKROTIK_DEFAULT_API_PORT=8728
MIKROTIK_DEFAULT_SSH_PORT=22
MIKROTIK_DEFAULT_MAC=04:F4:1C:E6:A9:ED

VITE_APP_NAME="${APP_NAME}"
